# Copy this file to .env and fill in real values.

# Django
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True

# Neon Postgres connection string
# Get it from: Neon dashboard -> your project -> Connection Details
# Recommended: use a SEPARATE database (or separate Neon project) from Part 1,
# e.g. name it "obe_part2" so the two systems never collide.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST.neon.tech/obe_part2?sslmode=require

# Comma-separated origins allowed to call this API (your React dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173
